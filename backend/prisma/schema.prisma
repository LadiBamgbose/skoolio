// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Quiz table - teachers generate quizzes
model Quiz {
  id            Int             @id @default(autoincrement())
  prompt        String
  questions     Json
  shareLink     String          @unique  // For students to access
  gradeLevel    String
  questionCount Int
  createdAt     DateTime        @default(now())
  ipAddress     String          // Rate limit: 3 quiz creations/month per IP
  
  responses     QuizResponse[]
  stats         QuizStats?
  
  @@index([ipAddress, createdAt])
  @@index([shareLink])
}

// Quiz responses - students submit answers
model QuizResponse {
  id              Int      @id @default(autoincrement())
  quizId          Int
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentName     String
  answers         Json
  score           Int
  totalQuestions  Int
  completedAt     DateTime @default(now())
  timeTaken       Int?
  
  @@index([quizId])
}

// Quiz statistics - aggregated data for teachers
model QuizStats {
  id                  Int      @id @default(autoincrement())
  quizId              Int      @unique
  quiz                Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  totalResponses      Int      @default(0)
  averageScore        Float    @default(0)
  highestScore        Int      @default(0)
  lowestScore         Int?
  averageTimeSeconds  Float?
  lastUpdated         DateTime @updatedAt
}
