// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - teachers who create quizzes
model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  firstName   String
  lastName    String
  city        String
  state       String
  plan        Plan     @default(BASIC)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Stripe subscription fields (null for free tier users)
  stripeCustomerId       String?              // Stripe customer ID
  stripeSubscriptionId   String?              // Current subscription ID
  subscriptionStatus     SubscriptionStatus?  // NULL for free users
  currentPeriodEnd       DateTime?            // When billing period ends
  cancelAtPeriodEnd      Boolean @default(false)
  
  quizzes     Quiz[]
  quizUsage   QuizUsage[]
}

// Plan enum for different subscription tiers
enum Plan {
  BASIC     // 5 quizzes/month - Free
  TEACHER   // 60 quizzes/month - $7.99
  ADVANCED  // 200 quizzes/month - $12.99
}

// Subscription status enum for Stripe subscriptions
enum SubscriptionStatus {
  ACTIVE          // Subscription is active
  PAST_DUE        // Payment failed, grace period
  CANCELED        // Subscription canceled
  INCOMPLETE      // Payment not completed
  TRIALING        // In trial period (if you add trials later)
}

// Quiz table - teachers generate quizzes
model Quiz {
  id            Int             @id @default(autoincrement())
  prompt        String
  questions     Json
  shareLink     String          @unique  // For students to access
  gradeLevel    String
  questionCount Int
  isActive      Boolean         @default(true)  // Controls if students can access quiz
  createdAt     DateTime        @default(now())
  
  // Keep existing IP tracking for anonymous users (nullable for authenticated)
  ipAddress     String?         // Nullable for authenticated users
  
  // Add teacher ownership (nullable for anonymous quizzes)
  teacherId     Int?            // Nullable for anonymous quizzes
  teacher       User?           @relation(fields: [teacherId], references: [id])
  
  responses     QuizResponse[]
  stats         QuizStats?
  
  @@index([ipAddress, createdAt])
  @@index([teacherId, createdAt])
  @@index([shareLink])
}

// Quiz responses - students submit answers
model QuizResponse {
  id              Int      @id @default(autoincrement())
  quizId          Int
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentName     String
  answers         Json
  score           Int
  totalQuestions  Int
  completedAt     DateTime @default(now())
  timeTaken       Int?
  
  @@index([quizId])
}

// Quiz statistics - aggregated data for teachers
model QuizStats {
  id                  Int      @id @default(autoincrement())
  quizId              Int      @unique
  quiz                Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  totalResponses      Int      @default(0)
  averageScore        Float    @default(0)
  highestScore        Int      @default(0)
  lowestScore         Int?
  averageTimeSeconds  Float?
  lastUpdated         DateTime @updatedAt
}

// Quiz usage tracking - monthly limits for users and IPs
model QuizUsage {
  id        Int      @id @default(autoincrement())
  userId    Int?     // Nullable for anonymous users
  ipAddress String?  // For anonymous tracking
  month     String   // "2024-01" format
  count     Int      @default(0)
  
  user      User?    @relation(fields: [userId], references: [id])
  
  @@unique([userId, month])
  @@unique([ipAddress, month])
}